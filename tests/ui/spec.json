     "select": "#build-select",
     "note": "current build is locked",
     "choose": {
      "labelContains": "current"
     },
     "expectDisabled": [
      "#switch-build-btn",
      "#delete-build-btn"
     ]
    },
    {
     "select": "#build-select",
     "note": "a stored build is unlocked",
     "choose": {
      "labelNotContaining": "current"
     },
     "expectEnabled": [
      "#switch-build-btn",
      "#delete-build-btn"
     ],
     "expectDisabled": [],
     "then_click": [
      "#switch-build-btn",
      "#delete-build-btn"
     ],
     "_then_click_comment": [
      "Destructive endpoints behind a selection-dependent button are clicked",
      "here, against a known selection; the sweep only reaches them in whatever",
      "state the select was left in."
     ]
    }
