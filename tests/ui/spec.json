   "expectText": [
    {
     "_comment": "names the job, not just 'something is running'",
     "selector": "#jobbar-text",
     "contains": "ComfyUI update"
    },
    {
     "_comment": "the current step, so a long silent phase is distinguishable",
     "selector": "#jobbar-text",
     "contains": "holding 4 machine-specific package(s)"
    },
    {
     "_comment": "elapsed time is formatted, not a raw second count",
     "selector": "#jobbar-text",
     "matches": "2m 05s"
