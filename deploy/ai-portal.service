[Unit]
Description=AI Tool Management Portal (web console)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/cortana/ai-projects/ai-portal
Environment=AI_PORTAL_HOST=0.0.0.0
Environment=AI_PORTAL_PORT=8090
ExecStart=/home/cortana/ai-projects/ai-portal/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8090 --log-level info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
