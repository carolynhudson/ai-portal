[Unit]
Description=AI Tool Management Portal (web console)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/cortana/ai-projects/ai-portal
EnvironmentFile=/home/cortana/ai/config/ai-env.env
EnvironmentFile=/home/cortana/ai/config/portal.env
ExecStart=/home/cortana/ai-projects/ai-portal/.venv/bin/python -m uvicorn app.main:app --host ${AI_PORTAL_HOST} --port ${AI_PORTAL_PORT} --log-level info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
