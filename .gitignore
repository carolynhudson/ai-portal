# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets / runtime state must never be committed (lives under ~/ai/state, not the repo)
*.secret
portal.auth.json
.env

# UI test harness dependencies (installed by scripts/check-ui.sh)
tests/ui/node_modules/
tests/ui/package-lock.json

# A local `npm install` of the agent harness itself lands these at the repo root. The portal has no
# JS build step, and its UI tests install into tests/ui/ (ignored above), so a root node_modules here
# is somebody's pi install and not part of this project.
/node_modules/
/package.json
/package-lock.json

# Drop a screenshot here to talk about it; it is not part of the repo
/*.png

# Design-playbook run trees (baseline evidence, drafts, shaping logs). They are hash-bound
# to the source they measured and regenerate on demand, so they are not repo content.
/.scratch/
